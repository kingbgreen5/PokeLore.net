{
  "name": "pokelore-astro-poc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs staging",
    "build:production": "node scripts/build.mjs production",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:production": "npm run build:production && wrangler deploy --config wrangler.production.jsonc",
    "verify": "node scripts/verify-all.mjs staging",
    "verify:production": "node scripts/verify-all.mjs production",
    "verify:team-coverage": "node scripts/verify-team-coverage.mjs",
    "verify:single-type-browser": "node scripts/single-type-coverage-browser.mjs",
    "verify:stress-browser": "node scripts/stress-browser.mjs",
    "verify:move-browser": "node scripts/move-browser.mjs",
    "verify:ability-browser": "node scripts/ability-browser.mjs",
    "verify:rse-feebas-browser": "node scripts/rse-feebas-browser.mjs",
    "verify:ability-crawl": "node scripts/crawl-ability-catalog.mjs",
    "verify:move-crawl": "node scripts/crawl-move-catalog.mjs",
    "verify:full-crawl": "node scripts/crawl-full-catalog.mjs",
    "measure:stress": "node scripts/measure-stress.mjs",
    "compare:stress-production": "node scripts/compare-stress-production.mjs",
    "audit:catalog-readiness": "node scripts/audit-catalog-readiness.mjs",
    "audit:form-semantics": "node scripts/audit-form-semantics.mjs",
    "audit:items": "node scripts/audit-items.mjs",
    "verify:items": "node scripts/verify-items.mjs"
  },
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "astro": "^6.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "linkedom": "^0.18.12",
    "wrangler": "4.137.0"
  }
}
