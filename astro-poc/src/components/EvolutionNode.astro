---
import PokemonCard from './PokemonCard.astro';
import { publicHref } from '../lib/links.js';
const { model } = Astro.props;
---
<div class="evolution-node evolution-node-horizontal">
  {model.methodText && <div class="evolution-method">{model.methodParts.map(part => part.type && part.slug ? <a href={publicHref(`/${part.type}/${part.slug}`)}>{part.text}</a> : part.text)}<span class="evolution-method-arrow" aria-hidden="true"></span>{model.note && <small>{model.note}</small>}</div>}
  <PokemonCard pokemon={model.pokemon} />
  {model.children.length > 0 && <div class="evolution-children">{model.children.map(child => <Astro.self model={child} />)}</div>}
</div>
