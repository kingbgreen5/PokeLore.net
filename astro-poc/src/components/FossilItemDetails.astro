---
import { publicHref } from '../lib/links.js';
import PokemonCard from './PokemonCard.astro';
const { data } = Astro.props;
const family = data.fossil;
const acquisition = data.acquisition?.acquisition ?? [];
const groups = [...new Map(acquisition.map(entry => [entry.games?.join('|') ?? 'Unknown games', { label: entry.games?.join(' & ') ?? 'Unknown games', entries: [] }])).values()];
for (const entry of acquisition) groups.find(group => group.label === (entry.games?.join(' & ') ?? 'Unknown games')).entries.push(entry);
const title = `Pokémon ${data.slug === 'old-amber' ? 'Revived From' : `Revived From the ${data.displayName}`}`;
const linkParts = paragraph => {
  const value = typeof paragraph === 'string' ? { text: paragraph, links: [] } : paragraph ?? { text: '', links: [] };
  const links = [...(value.links ?? [])].sort((a,b) => value.text.indexOf(a.label) - value.text.indexOf(b.label));
  let cursor = 0; const parts = [];
  for (const link of links) { const index = value.text.indexOf(link.label, cursor); if (index < 0) continue; parts.push({ text: value.text.slice(cursor,index) }); parts.push({ text: link.label, href: link.to }); cursor = index + link.label.length; }
  parts.push({ text: value.text.slice(cursor) }); return parts;
};
---
<section class="fossil-section fossil-family"><h2>{title}</h2><p><strong>Revived Pokémon:</strong> <a href={publicHref(`/pokemon/${family.restoredPokemon[0].slug}`)}>{family.restoredPokemon[0].displayName}</a></p>{family.restoredPokemon.length > 1 && <p><strong>Later evolution:</strong> <a href={publicHref(`/pokemon/${family.restoredPokemon[0].slug}`)}>{family.restoredPokemon[0].displayName}</a> → <a href={publicHref(`/pokemon/${family.restoredPokemon.at(-1).slug}`)}>{family.restoredPokemon.at(-1).displayName}</a>{family.evolutionSummary.replace(/^.*? evolves into .*?(?= at | during |\.$)/,'')}</p>}{data.slug.startsWith('fossilized-') && <p>{family.evolutionSummary}</p>}</section>

<details class="fossil-section where" open><summary><h2>Where to Find</h2><span>▲</span></summary><label>Generation <select id="generation-filter"><option value="all">All Generations</option>{[...new Set(acquisition.map(entry=>entry.generation).filter(Boolean))].sort((a,b)=>a-b).map(generation=><option value={generation}>Generation {generation}</option>)}</select></label><div class="acquisition-groups">{groups.map(group=><section class="game-group" data-generations={group.entries.map(entry=>entry.generation).filter(Boolean).join(',')}><h3>{group.label}</h3>{group.entries.map(entry=><article class="acquisition-card"><div class="acquisition-head">{typeof entry.location === 'object' ? <a href={publicHref(`/location/${entry.location.name}`)}>{entry.location.displayName}</a> : <strong>{entry.location}</strong>}<span>{entry.acquisitionType?.split('-').map(word=>word[0].toUpperCase()+word.slice(1)).join(' ')}</span></div>{entry.versionExclusive&&<p><strong>Version Exclusive: Yes</strong></p>}{entry.area&&<p><strong>Area</strong><br />{entry.area}</p>}<p>{entry.method}</p>{entry.requirements?.length>0&&<><strong>Requirements</strong><ul>{entry.requirements.map(requirement=><li>{requirement}</li>)}</ul></>}<p><strong>Repeatable:</strong> {entry.repeatable?'Yes':'No'}</p></article>)}</section>)}</div></details>

{data.relatedLinks?.links?.length > 0 && <section class="fossil-section related"><h2>{data.relatedLinks.title ?? 'Related Guides'}</h2>{data.relatedLinks.links.map(link=><a class="related-link" href={publicHref(link.to)}><strong>{link.label}</strong><span>{link.description}</span></a>)}</section>}

{data.oaksNotes && <section class="fossil-section notes"><h2>{data.oaksNotes.title ?? "Oak's Notes"}</h2>{data.oaksNotes.sections?.map(section=><section><h3>{section.heading}</h3>{section.body?.map(paragraph=><p>{linkParts(paragraph).map(part=>part.href?<a href={publicHref(part.href)}>{part.text}</a>:part.text)}</p>)}{section.links?.some(link=>link.to?.startsWith('/pokemon/'))&&<div class="pokemon-links">{data.fossilPokemon.map(pokemon=><PokemonCard pokemon={pokemon} />)}</div>}</section>)}</section>}

{data.flavorTextEntries?.length > 0 && <section class="fossil-section"><h2>Flavor Text</h2>{data.flavorTextEntries.map(entry=><p><strong>{entry.versionGroups.map(game=>game.split('-').map(word=>word[0].toUpperCase()+word.slice(1)).join(' ')).join(' / ')}</strong><br />{entry.text}</p>)}</section>}

<section class="fossil-section overview"><h2>Overview</h2><dl><div><dt>Cost</dt><dd>{data.cost.toLocaleString()}</dd></div><div><dt>Pocket</dt><dd>{data.category?.pocket}</dd></div><div><dt>Category</dt><dd>{data.category?.displayName}</dd></div><div><dt>Fling Power</dt><dd>{data.fling?.power ?? '—'}</dd></div></dl></section><section class="fossil-section"><h2>Attributes</h2><p>{data.attributes?.map(attribute=>attribute.split('-').map(word=>word[0].toUpperCase()+word.slice(1)).join(' ')).join(', ') ?? '—'}</p></section>

<script is:inline>
  document.getElementById('generation-filter')?.addEventListener('change', event => {
    const selected = event.target.value;
    document.querySelectorAll('.game-group').forEach(group => { group.hidden = selected !== 'all' && !group.dataset.generations.split(',').includes(selected); });
  });
</script>

<style>
  .fossil-section{border:1px solid #666;border-radius:12px;margin:0 0 2rem;padding:1rem;text-align:left}.fossil-section h2{margin:0 0 1rem}.fossil-section h3{margin:1.25rem 0 .6rem}.fossil-section p{line-height:1.55}.fossil-family{border:0;padding:0}.fossil-family p{margin:.5rem 0}.where summary{align-items:center;color:#7dd3fc;cursor:pointer;display:flex;justify-content:space-between}.where summary h2{margin:0}.where[open] summary{margin-bottom:1rem}.where label{display:block;margin-bottom:1rem}.where select{background:#2c2c2c;border:2px solid #555;border-radius:12px;color:#fff;font-size:1rem;margin-left:.5rem;padding:.45rem .65rem}.acquisition-groups{display:grid;gap:1rem}.game-group{display:grid;gap:.75rem}.game-group h3{margin:.25rem 0}.acquisition-card{border:1px solid #666;border-radius:12px;padding:1rem}.acquisition-card p{margin:.65rem 0}.acquisition-card ul{margin:.35rem 0;padding-left:1.25rem}.acquisition-head{align-items:flex-start;display:flex;gap:.75rem;justify-content:space-between}.acquisition-head>a,.acquisition-head>strong{font-size:1.1rem}.acquisition-head span{border:1px solid #888;border-radius:999px;font-size:.8rem;padding:.25rem .65rem;text-align:center}.related-link{border:1px solid #555;border-radius:10px;color:inherit;display:grid;gap:.25rem;margin-top:.75rem;padding:.85rem;text-decoration:none}.related-link span{opacity:.82}.notes{background:rgba(0,202,219,.1);border-color:rgba(0,202,219,.45)}.notes>section{padding-bottom:1rem}.pokemon-links{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;margin-top:.75rem}.pokemon-links :global(.pokemon-summary-card){width:135px}.overview dl{display:grid;gap:.5rem;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));margin:0}.overview dl>div{background:#202026;border:1px solid #555;border-radius:8px;padding:.65rem}.overview dt{color:#fab856;font-size:.8rem;font-weight:700}.overview dd{margin:.25rem 0 0}@media(max-width:600px){.acquisition-head{align-items:flex-start;flex-direction:column}.fossil-section{padding:.8rem}}
</style>
