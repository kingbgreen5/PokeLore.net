---
const { acquisition = [] } = Astro.props;
const FAMILIES = [
  [['Pokémon Red','Pokémon Blue','Pokémon Yellow'],'Pokémon Red, Blue & Yellow'],
  [['Pokémon Gold','Pokémon Silver','Pokémon Crystal'],'Pokémon Gold, Silver & Crystal'],
  [['Pokémon Ruby','Pokémon Sapphire','Pokémon Emerald'],'Pokémon Ruby, Sapphire & Emerald'],
  [['Pokémon FireRed','Pokémon LeafGreen'],'Pokémon FireRed & LeafGreen'],
  [['Pokémon Diamond','Pokémon Pearl','Pokémon Platinum'],'Pokémon Diamond, Pearl & Platinum'],
  [['Pokémon HeartGold','Pokémon SoulSilver'],'Pokémon HeartGold & SoulSilver'],
  [['Pokémon Black','Pokémon White'],'Pokémon Black & White'],
  [['Pokémon Black 2','Pokémon White 2'],'Pokémon Black 2 & White 2'],
  [['Pokémon X','Pokémon Y'],'Pokémon X & Y'],
  [['Pokémon Omega Ruby','Pokémon Alpha Sapphire'],'Pokémon Omega Ruby & Alpha Sapphire'],
  [['Pokémon Sun','Pokémon Moon'],'Pokémon Sun & Moon'],
  [['Pokémon Ultra Sun','Pokémon Ultra Moon'],'Pokémon Ultra Sun & Ultra Moon'],
  [['Pokémon Sword','Pokémon Shield'],'Pokémon Sword & Shield'],
  [['Pokémon Brilliant Diamond','Pokémon Shining Pearl'],'Pokémon Brilliant Diamond & Shining Pearl'],
  [['Pokémon Legends: Arceus'],'Pokémon Legends: Arceus'],
  [['Pokémon Scarlet','Pokémon Violet'],'Pokémon Scarlet & Violet'],
  [['Pokémon Legends: Z-A'],'Pokémon Legends: Z-A']
];
const familyFor = games => FAMILIES.find(([familyGames]) => games.length && games.every(game => familyGames.includes(game)));
const groupsByKey = new Map();
for (const method of acquisition) {
  const games = method.games ?? [];
  const family = familyFor(games);
  const key = family?.[1] ?? (games.join('|') || `Other Games: ${method.generation ?? 'unknown'}`);
  if (!groupsByKey.has(key)) groupsByKey.set(key, { label: family?.[1] ?? (games.join(', ') || 'Other Games'), games: family?.[0] ?? games, entries: [] });
  groupsByKey.get(key).entries.push(method);
}
const groups = [...groupsByKey.values()];
const generations = [...new Set(acquisition.map(method => method.generation).filter(Boolean))].sort((a,b) => a-b);
const typeLabel = type => String(type ?? 'Unknown').split('-').map(word => word[0]?.toUpperCase() + word.slice(1)).join(' ');
const gameList = games => games.map(game => game.replace(/^Pokémon:?\s*/, '')).join(' & ');
const notice = (method, group) => (method.games?.length < group.games.length && method.games.every(game => group.games.includes(game))) ? `${gameList(method.games)} only` : method.versionExclusive ? 'Version Exclusive: Yes' : null;
---
<details class="where-to-find" open>
  <summary><h2>Where to Find</h2><span aria-hidden="true">⌄</span></summary>
  <label>Generation <select data-generation-filter aria-label="Filter acquisition methods by generation"><option value="all">All Generations</option>{generations.map(generation => <option value={generation}>Generation {generation}</option>)}</select></label>
  <div class="acquisition-groups">
    {groups.map(group => <section class="game-group" data-generations={[...new Set(group.entries.map(entry => entry.generation))].join(',')}>
      <h3>{group.label}</h3>
      {group.entries.map(method => <article class="acquisition-card" data-generation={method.generation}>
        <div class="acquisition-head">{typeof method.location === 'object' && method.location?.name ? <a href={`/location/${method.location.name}`}>{method.location.displayName}</a> : <strong>{method.location ?? 'Location unavailable'}</strong>}<span>{typeLabel(method.acquisitionType)}</span></div>
        {notice(method, group) && <p class="notice">{notice(method, group)}</p>}
        {method.area && <div><strong>Area</strong><p>{method.area}</p></div>}
        {method.method && <p>{method.method}</p>}
        {method.requirements?.length > 0 && <div><strong>Requirements</strong><ul>{method.requirements.map(requirement => <li>{requirement}</li>)}</ul></div>}
        {method.notes && <div><strong>Notes</strong><p>{method.notes}</p></div>}
        <p class="repeatable"><strong>Repeatable:</strong> {method.repeatable ? 'Yes' : 'No'}</p>
      </article>)}
    </section>)}
  </div>
</details>
<script>
  document.querySelectorAll('[data-generation-filter]').forEach(select => select.addEventListener('change', () => {
    const generation = select.value;
    document.querySelectorAll('.acquisition-card').forEach(card => card.toggleAttribute('hidden', generation !== 'all' && card.dataset.generation !== generation));
  }));
</script>
<style>
  .where-to-find{border:2px solid #4d4d55;border-radius:14px;margin:0 auto 1.25rem;padding:1rem}.where-to-find summary{align-items:center;color:#7dd3fc;cursor:pointer;display:flex;justify-content:space-between}.where-to-find summary h2{margin:0}.where-to-find[open] summary{margin-bottom:1rem}.where-to-find label{align-items:center;display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:1rem}.where-to-find select{background:#2c2c2c;border:2px solid #555;border-radius:12px;color:#fff;font:inherit;padding:.55rem .8rem}.acquisition-groups,.game-group{display:grid;gap:1rem}.game-group:not(:has(.acquisition-card:not([hidden]))){display:none}.game-group h3{color:#f8fafc;margin:.25rem 0 .15rem}.acquisition-card{border:1px solid #666;border-radius:12px;padding:1rem}.acquisition-head{align-items:flex-start;display:flex;flex-wrap:wrap;gap:.75rem;justify-content:space-between;margin-bottom:.75rem}.acquisition-head>a,.acquisition-head>strong{font-size:1.1rem}.acquisition-head span{border:1px solid #888;border-radius:999px;font-size:.8rem;padding:.25rem .65rem}.acquisition-card p{line-height:1.6;margin:.65rem 0}.acquisition-card ul{margin:.35rem 0;padding-left:1.25rem}.acquisition-card .notice{font-weight:700}.acquisition-card .repeatable{margin-bottom:0}@media(max-width:600px){.where-to-find{padding:.8rem}.acquisition-head{flex-direction:column}}
</style>
