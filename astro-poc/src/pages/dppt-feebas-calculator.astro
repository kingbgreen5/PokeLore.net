---
import BaseLayout from '../layouts/BaseLayout.astro';
import DpptFeebasCalculatorTool from '../islands/DpptFeebasCalculatorTool.jsx';
const canonical = 'https://pokelore.net/dppt-feebas-calculator';
const description = 'Upload a local Diamond, Pearl, or Platinum save file or enter two consecutive Jubilife TV lottery numbers to find today’s four Feebas fishing tiles in Mt. Coronet.';
const structuredData = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'DPPt Feebas Calculator', url: canonical, applicationCategory: 'GameApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', description, isAccessibleForFree: true };
---
<BaseLayout seo={{ title: 'Feebas Tile Calculator for Diamond, Pearl, and Platinum | PokéLore', description, canonical, structuredData }}>
  <article class="dppt-page"><header><p>Pokémon tools</p><h1>Pokemon Diamond, Pearl, and Platinum Feebas Calculator</h1><p>Find today&apos;s four active Feebas fishing tiles in Mt. Coronet B1F.</p></header><section class="calculator" aria-label="DPPt Feebas calculator"><noscript><p>This calculator requires JavaScript to run. The guide below still explains both methods.</p></noscript><DpptFeebasCalculatorTool client:load /></section><section class="guide"><h2>How this calculator works</h2><p>Use a compatible Diamond, Pearl, or Platinum save file for an exact result, or enter the older and newer Jubilife TV lottery numbers from consecutive in-game days. Enter the older number as Yesterday and the newer number as Today.</p><h2>Save-file privacy</h2><p>Your save file is processed locally in your browser. It is never uploaded, stored, or sent to PokéLore. Only the data needed to calculate the Feebas result is read.</p><h2>Using the Mt. Coronet map</h2><p>Exact mode marks the four fishing tiles where Feebas can appear. Hint mode marks a 16-tile fishable search area around each result. Fish into the marked tile; it is not the tile where your character stands.</p><h2>Great Marsh daily Pokémon</h2><p>The same daily seed also determines one special Pokémon for each of the six Great Marsh areas after the National Dex. Diamond/Pearl and Platinum use different result tables.</p><h2>Frequently asked questions</h2><h3>Are my lottery observations ordered?</h3><p>Yes. The two lottery numbers must be consecutive in-game days, with the older value entered first.</p><h3>Why has Feebas not appeared yet?</h3><p>Feebas is a 50% fishing encounter on an active tile, so fish several times into the marked square.</p><p><a href="/topic/catching-feebas-in-pokemon-diamond-pearl-and-platinum">Read the Diamond, Pearl, and Platinum Feebas guide</a> or <a href="/tools">browse all Pokémon tools</a>.</p></section></article>
</BaseLayout>
<style>.dppt-page{box-sizing:border-box;display:grid;gap:1.5rem;margin:0 auto;max-width:1080px;padding:2rem;text-align:left}.dppt-page header{text-align:center}.dppt-page header p{margin:.5rem auto;max-width:760px}.dppt-page h1{line-height:1.2}.guide{background:#1b1c23;border:1px solid #343844;border-radius:8px;display:grid;gap:.7rem;padding:1.25rem}.guide h2,.guide h3{letter-spacing:0;margin:.45rem 0}.guide p{line-height:1.5;margin:0}@media(max-width:600px){.dppt-page{padding:1rem}}</style>
