---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvTrainingRoutesTool from '../islands/EvTrainingRoutesTool.jsx';
const canonical = 'https://pokelore.net/ev-training-routes';
const description = 'Find the best Pokémon EV training locations by game. Compare routes for HP, Attack, Defense, Sp. Atk, Sp. Def, and Speed EVs, plus Power Item tips.';
const structuredData = { '@context': 'https://schema.org', '@graph': [{ '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: 'Best Pokémon EV Training Locations Calculator | PokéLore', description, mainEntity: { '@id': `${canonical}#ev-training-routes-tool` } }, { '@type': 'WebApplication', '@id': `${canonical}#ev-training-routes-tool`, name: 'Best Pokémon EV Training Locations Calculator', url: canonical, applicationCategory: 'GameApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', description, isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } }] };
---
<BaseLayout seo={{ title: 'Best Pokémon EV Training Locations Calculator | PokéLore', description, canonical, structuredData }}>
  <article class="ev-page"><header><h1>Best EV Training Locations in every Pokemon Game</h1><p>Find the best EV training spots by game and stat, ranked by encounter chance, EVs per encounter, and clean target-only chance.</p></header><section class="tool-region" aria-label="EV training calculator"><noscript><p>This calculator requires JavaScript to run.</p></noscript><EvTrainingRoutesTool initialSearch={Astro.url.search} client:load /></section><section class="guide"><h2>EV Training Guide</h2><p>Use the route finder to choose a game and stat. It compares repeatable wild encounter tables and shows the top fifteen locations for that setup.</p><h3>What are EVs?</h3><p>Effort Values are hidden points that make a Pokémon’s stats stronger through training. In most games, defeating a Pokémon awards EVs in HP, Attack, Defense, Special Attack, Special Defense, or Speed.</p><p>From Generation III onward, every four EVs in a stat are worth one additional stat point at Level 100. A Pokémon can have 510 EVs total; since Generation VI, an individual stat can hold 252 EVs.</p><h3>How the calculator ranks locations</h3><p>Stat chance is the share of battles that award your selected stat. Stat purity is the share that award only that stat. EV per encounter is the average selected-stat EVs expected from each wild battle.</p><h3>Game and EV multipliers</h3><p>Select the exact game because encounter tables and available Pokémon differ between versions. Macho Brace doubles EVs earned through battle. Pokérus normally doubles battle EVs and can stack with Macho Brace; it has no effect in Pokémon Scarlet and Violet.</p></section></article>
</BaseLayout>
<style>.ev-page{box-sizing:border-box;display:grid;gap:1.5rem;margin:0 auto;max-width:1080px;padding:2rem;text-align:left}.ev-page header{text-align:center}.ev-page header h1{line-height:1.2;margin-bottom:.75rem}.ev-page header p{margin:0 auto;max-width:760px}.tool-region{margin:0 auto;width:100%}.guide{background:#1b1c23;border:1px solid #343844;border-radius:8px;display:grid;gap:.75rem;padding:1.25rem}.guide h2,.guide h3{letter-spacing:0;margin:.5rem 0}.guide p{line-height:1.5;margin:0}</style>
