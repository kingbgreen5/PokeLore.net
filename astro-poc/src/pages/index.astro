---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeSeo } from '../lib/seo.js';
import { POC_SLUGS, pokemonPath } from '../lib/routes.js';
import { loadPokemon } from '../lib/pokemonData.js';
---
<BaseLayout seo={homeSeo()}>
  <h1>PokéLore</h1>
  <p>Explore Pokémon lore, stats, evolution, learnsets and game analysis. This reference preview brings four Pokémon into a fully static Pokédex.</p>
  <h2>Explore the Pokédex</h2>
  <div class="cards">{POC_SLUGS.map(slug => {
    const data = loadPokemon(slug);
    return <a class="card" href={pokemonPath(slug)}><img src={data.artwork} alt="" width="160" height="160" /><strong>{data.name}</strong></a>;
  })}</div>
</BaseLayout>
