---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { itemModel, ITEM_SLUGS } from '../../lib/itemData.js';
export function getStaticPaths(){return ITEM_SLUGS.map(slug=>({params:{slug}}));}
const data=itemModel(Astro.params.slug);const pokemonLink=slug=>`/pokemon/${slug}`;
---
<BaseLayout seo={data.seo}><article class="item-detail"><a class="item-back" href="/items">← Back To Items</a><header class="item-header">{data.sprite&&<img src={data.sprite} alt={data.displayName} width="72" height="72" />}<div><p class="item-category">{data.category?.displayName??data.category?.name??'Item'}</p><h1>{data.displayName}</h1></div></header>{data.shortEffect&&<p class="item-summary">{data.shortEffect}</p>}{data.effect&&<section class="item-section"><h2>Effect</h2><p>{data.effect}</p></section>}<section class="item-section item-facts"><h2>Item Details</h2><dl><div><dt>Pocket</dt><dd>{data.category?.pocket??'—'}</dd></div><div><dt>Cost</dt><dd>{data.cost>0?`${data.cost.toLocaleString()} PokéDollars`:'Not sold'}</dd></div><div><dt>Fling Power</dt><dd>{data.fling?.power??'—'}</dd></div><div><dt>Attributes</dt><dd>{data.attributes?.length?data.attributes.join(', '):'—'}</dd></div></dl></section>{data.heldByPokemon.length>0&&<section class="item-section"><h2>Held By Pokémon <small>{data.heldByPokemon.length}</small></h2><div class="item-links">{data.heldByPokemon.map(holder=><a href={pokemonLink(holder.name)}>{holder.displayName}</a>)}</div></section>}{data.machines.length>0&&<section class="item-section"><h2>Teaches</h2><div class="item-links">{[...new Map(data.machines.map(row=>[row.move.name,row.move])).values()].map(move=><a href={`/move/${move.name}`}>{move.displayName}</a>)}</div></section>}{data.evolution.length>0&&<section class="item-section"><h2>Evolution Relationships</h2>{data.evolution.map(rule=><p><a href={pokemonLink(rule.sourceSlug)}>{rule.sourceDisplayName}</a> → <a href={pokemonLink(rule.targetSlug)}>{rule.targetDisplayName}</a>{rule.games?.length?` (${rule.games.join(', ')})`:''}</p>)}</section>}{data.berry&&<section class="item-section"><h2>Berry Details</h2><p>{Object.entries(data.berry).filter(([,value])=>value!==null&&value!==undefined&&typeof value!=='object').map(([key,value])=>`${key}: ${value}`).join(' · ')}</p></section>}{data.acquisition?.acquisition?.length>0&&<section class="item-section"><h2>Where To Find It</h2>{data.acquisition.acquisition.map(method=><p>{method.games?.join(', ')}: {method.method??method.location??'Acquisition information available.'}</p>)}</section>}{data.oaksNotes&&<section class="item-section"><h2>{data.oaksNotes.title??'Oak’s Notes'}</h2>{data.oaksNotes.sections?.flatMap(section=>section.body??[]).map(block=><p>{block.text}</p>)}</section>}<nav class="sr-only" aria-label="Breadcrumb"><a href="/">PokéLore</a> › <a href="/items">Items</a> › {data.displayName}</nav></article></BaseLayout>
<style>
  .item-detail{box-sizing:border-box;margin:0 auto;max-width:900px;padding:2rem 1rem 4rem;text-align:left}.item-back{border:1px solid #555;border-radius:999px;color:inherit;display:inline-block;margin-bottom:1.5rem;padding:.45rem .85rem}.item-header{align-items:center;display:flex;gap:1rem;justify-content:center;margin-bottom:1.5rem;text-align:center}.item-header img{image-rendering:pixelated;object-fit:contain}.item-category{color:#fab856;font-size:.8rem;font-weight:800;letter-spacing:.06em;margin:0;text-transform:uppercase}.item-header h1{font-size:clamp(2.4rem,7vw,4.8rem);line-height:1;margin:.35rem 0}.item-summary{color:#b8c7df;font-size:1.1rem;line-height:1.5;margin:0 auto 1.5rem;max-width:680px;text-align:center}.item-section{border:2px solid #4d4d55;border-radius:14px;margin:0 auto 1.25rem;padding:1rem}.item-section h2{margin-top:0}.item-section h2 small{font-size:.85rem;font-weight:400}.item-section p{line-height:1.6}.item-facts dl{display:grid;gap:.5rem;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin:0}.item-facts dl>div{background:#202026;border:1px solid #555;border-radius:8px;padding:.65rem}.item-facts dt{color:#fab856;font-size:.8rem;font-weight:700}.item-facts dd{margin:.25rem 0 0;overflow-wrap:anywhere}.item-links{display:flex;flex-wrap:wrap;gap:.5rem}.item-links a{background:#202026;border:1px solid #555;border-radius:8px;padding:.45rem .65rem}@media(max-width:600px){.item-detail{padding:1.25rem .25rem 3rem}.item-section{padding:.8rem}}
</style>
