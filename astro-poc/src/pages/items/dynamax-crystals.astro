---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  DYNAMAX_CRYSTAL_GUIDE_PATH,
  formatDynamaxPokemonName,
  getReleasedDynamaxCrystals,
  validateReleasedDynamaxCrystals
} from '../../../../src/utils/dynamaxCrystals.js';

// This route deliberately consumes the production Dynamax dataset and helper,
// preserving the React guide's source of truth and release ordering.
validateReleasedDynamaxCrystals();
const releasedCrystals = getReleasedDynamaxCrystals();
const seo = {
  title: 'Dynamax Crystals Guide: All Released Crystal Raids | PokéLore',
  description: 'Learn how Dynamax Crystals work in Pokemon Sword and Shield, how to use them at Watchtower Lair, and which 12 crystals were officially released.',
  canonical: `https://pokelore.net${DYNAMAX_CRYSTAL_GUIDE_PATH}`,
  robots: 'index,follow,max-image-preview:large'
};
const pokemonList = pokemonSlugs => pokemonSlugs.map((slug, index) => ({
  slug,
  name: formatDynamaxPokemonName(slug),
  separator: pokemonSlugs.length === 2
    ? (index === 0 ? ' and ' : '')
    : (index === pokemonSlugs.length - 1 ? '' : index === pokemonSlugs.length - 2 ? ', and ' : ', ')
}));
---
<BaseLayout {seo}>
  <article class="dynamax-guide">
    <a href="/items">Back To Items</a>
    <h1>Dynamax Crystals Guide: Released Crystal Raids</h1>

    <section>
      <h2>What Dynamax Crystals Are</h2>
      <p>Dynamax Crystals are special event items introduced in Pokemon Sword and Shield. They were designed to activate a specific Max Raid Battle at Watchtower Lair in the Watchtower Ruins area of the Wild Area.</p>
      <p>After a usable crystal is selected from the Bag near Watchtower Lair, its associated Pokemon becomes available at the den until midnight or until it is caught.</p>
    </section>

    <section>
      <h2>How They Were Obtained</h2>
      <p>Released Dynamax Crystals were obtained through limited-time serial-code promotions, game purchase bonuses, magazines, guidebooks, or participating retailers. They were not normally found in the overworld or sold in Poke Marts.</p>
      <p>Most original Dynamax Crystal distributions have ended. Expired serial codes are not implied to still be redeemable.</p>
    </section>

    <section>
      <h2>Released Dynamax Crystals</h2>
      <p>Pokemon Sword and Shield contain data for 300 differently named Dynamax Crystals, but only 12 were officially distributed and made available to players.</p>
      <div class="crystal-list">
        {releasedCrystals.map(crystal => <article class="crystal">
          <h3><a href={`/item/${crystal.slug}`}>{crystal.displayName}</a></h3>
          <p><strong>Raid:</strong> {crystal.raidType} Max Raid Battle featuring {pokemonList(crystal.raidPokemon).map(pokemon => <><a href={`/pokemon/${pokemon.slug}`}>{pokemon.name}</a>{pokemon.separator}</>)}.</p>
          {crystal.versionNotes && <p>{crystal.versionNotes}</p>}
          <p><strong>Original acquisition:</strong> {crystal.acquisitionSummary}</p>
        </article>)}
      </div>
    </section>

    <section>
      <h2>Unused Crystal Data</h2>
      <p>The remaining 288 Dynamax Crystal item records are unused game-data entries. Those pages remain accessible for database completeness, but they are not included in the sitemap and are marked noindex because the items were never officially distributed.</p>
    </section>
  </article>
</BaseLayout>
<style>
  .dynamax-guide{margin:0 auto;max-width:1000px;padding:2rem;text-align:left}
  .dynamax-guide section{margin-bottom:2rem}
  .crystal-list{display:grid;gap:1rem}
  .crystal{border:1px solid #666;border-radius:12px;padding:1rem}
  .crystal h3{margin-top:0}
</style>
