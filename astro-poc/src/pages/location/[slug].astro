---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCATION_SLUGS, locationModel } from '../../lib/locationData.js';
import { loadPokemon } from '../../lib/pokemonData.js';
import TypeBadge from '../../components/TypeBadge.astro';
export function getStaticPaths() { return LOCATION_SLUGS.map(slug => ({ params: { slug } })); }
const data = locationModel(Astro.params.slug);
const titleCase = value => String(value ?? '').split('-').filter(Boolean).map(word => word[0]?.toUpperCase() + word.slice(1)).join(' ');
const level = row => row.minLevel == null && row.maxLevel == null ? '—' : row.minLevel === row.maxLevel ? `Lv. ${row.minLevel}` : `Lv. ${row.minLevel}-${row.maxLevel}`;
const pokemonRows = data.encounterRows;
const encounterGroups = data.areas.map(area => ({
  ...area,
  methods: [...new Set(pokemonRows.filter(row => row.area === area.displayName).map(row => row.method))].map(method => ({
    method,
    rows: pokemonRows.filter(row => row.area === area.displayName && row.method === method),
  })),
})).filter(area => area.methods.some(group => group.rows.length > 0));
const isPokeathlon = Astro.params.slug === 'pokeathlon-dome';
const WEEKDAYS = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
const itemRows = (data.locationItems?.items ?? []).flatMap(entry => (entry.versions ?? []).flatMap(version => (version.methods ?? []).map(method => ({ item: entry.item, version: version.version, method }))));
const itemVersions = [...new Set(itemRows.map(row => row.version))];
const methodText = method => [method.details, method.notes, ...(method.requirements ?? [])].filter(Boolean).join(' ');
const formatCost = cost => cost?.amount == null ? '' : `${Number(cost.amount).toLocaleString()} ${cost.currency ?? ''}`.trim();
const uniqueItems = rows => [...new Map(rows.map(row => [`${row.item.name}|${row.version}`, row])).values()].sort((a,b) => a.item.displayName.localeCompare(b.item.displayName) || a.version.localeCompare(b.version));
const athleteByDay = day => uniqueItems(itemRows.filter(row => row.method.area === 'Athlete Shop' && new RegExp(`\\b${day}\\b`, 'i').test(methodText(row.method))));
const dataCardsByLevel = levelNumber => uniqueItems(itemRows.filter(row => row.method.area === 'Data Card Shop' && new RegExp(`level ${levelNumber}\\b`, 'i').test(methodText(row.method))));
const vendingItems = uniqueItems(itemRows.filter(row => row.method.area === 'Player vending machines'));
const additionalItems = uniqueItems(itemRows.filter(row => !['Athlete Shop', 'Data Card Shop', 'Player vending machines'].includes(row.method.area)));
const notePokemon = links => links.map(link => ({ ...link, pokemon: (() => { const slug = link.to?.split('/').filter(Boolean).pop(); try { const model = slug ? loadPokemon(slug) : null; return model ? { ...model.p, displayName: model.name } : null; } catch { return null; } })() })).filter(row => row.pokemon);
---
<BaseLayout seo={data.seo}>
  <article class="location-detail">
    <a class="location-back" href="/locations">← Back To Locations</a>
    <header><p class="location-region">{data.region?.displayName ?? 'Region not specified'}</p><h1>{data.displayName}</h1><p class="location-summary">{data.seo.description}</p></header>
    {data.gameIndices?.length > 0 && <p class="location-generations">Generations: {[...new Set(data.gameIndices.map(entry => titleCase(entry.generation)))].join(', ')}</p>}
    {data.areas.length > 0 && <section class="location-section"><h2>Areas <small>{data.areas.length}</small></h2><div class="area-links">{data.areas.map(area => <a href={`#encounter-area-${area.name}`}>{area.displayName}</a>)}</div></section>}
    {data.encounterRows.length > 0 && <details class="location-section encounter-section" open>
      <summary><span>Pokémon Encounters</span><small>{data.encounterRows.length}</small></summary>
      {data.encounterRows.length === 0 ? <p>No Pokémon encounters are recorded for this location.</p> : <div class="encounter-content">
        <label for="location-game-filter">Filter Encounters By Game</label>
        <select id="location-game-filter">{data.versions.map((version, index) => <option value={version} selected={index === 0}>{titleCase(version)}</option>)}</select>
        <div class="encounter-groups">{encounterGroups.map(area => <section class="encounter-area" aria-labelledby={`encounter-area-${area.name}`}><h3 id={`encounter-area-${area.name}`}>{area.displayName}</h3>{area.methods.map(group => <div class="encounter-method"><h4>{titleCase(group.method)}</h4><div class="encounter-table-wrap"><table><thead><tr><th class="sprite-column" aria-label="Image"></th><th class="pokemon-name-column">Pokémon</th><th>Level</th><th>Chance</th></tr></thead><tbody>{group.rows.map((row, index) => <tr data-game={row.version} data-pokemon={row.pokemon.name} data-display={row.pokemon.displayName} data-sprite={row.pokemon.sprite} data-min-level={row.minLevel ?? ''} data-max-level={row.maxLevel ?? ''} data-chance={row.chance ?? ''} key={`${row.pokemon.name}-${row.version}-${row.method}-${index}`}><td class="sprite-column"><img class="encounter-sprite" src={row.pokemon.sprite} alt="" width="24" height="24" loading="lazy" /></td><td class="pokemon-name-column"><a href={`/pokemon/${row.pokemon.name}`}>{row.pokemon.displayName}</a></td><td>{level(row)}</td><td>{row.chance == null ? '—' : `${row.chance}%`}</td></tr>)}</tbody></table></div></div>)}</section>)}</div>
      </div>}
    </details>}
    {data.items.length > 0 && (isPokeathlon ? <details class="location-section pokeathlon-items" open>
      <summary><span>Items Found Here</span><small>{data.items.length}</small></summary>
      {itemVersions.length > 1 && <label class="item-version-filter" for="location-item-version-filter">Game Version<select id="location-item-version-filter">{itemVersions.map((version, index) => <option value={version} selected={index === 0}>{version}</option>)}</select></label>}
      <div class="item-shop-groups">
        <section class="item-shop-group"><h3>Athlete Shop</h3>{WEEKDAYS.filter(day => athleteByDay(day).length).map(day => <div class="item-shop-subgroup"><h4>{day}</h4><div class="item-shop-grid">{athleteByDay(day).map(row => <a class="item-shop-card" data-item-version={row.version} href={`/item/${row.item.name}`}><img src={row.item.sprite} alt="" width="32" height="32" loading="lazy" /><span><strong>{row.item.displayName}</strong>{formatCost(row.method.cost) && <small>{formatCost(row.method.cost)}</small>}</span></a>)}</div></div>)}</section>
        <section class="item-shop-group"><h3>Data Card Shop</h3>{[1,2,3,4,5].filter(levelNumber => dataCardsByLevel(levelNumber).length).map(levelNumber => <div class="item-shop-subgroup"><h4>Level {levelNumber}</h4><div class="item-shop-grid">{dataCardsByLevel(levelNumber).map(row => <a class="item-shop-card" data-item-version={row.version} href={`/item/${row.item.name}`}><img src={row.item.sprite} alt="" width="32" height="32" loading="lazy" /><span><strong>{row.item.displayName}</strong></span></a>)}</div></div>)}</section>
        {vendingItems.length > 0 && <section class="item-shop-group"><h3>Vending Machines</h3><div class="item-shop-grid">{vendingItems.map(row => <a class="item-shop-card" data-item-version={row.version} href={`/item/${row.item.name}`}><img src={row.item.sprite} alt="" width="32" height="32" loading="lazy" /><span><strong>{row.item.displayName}</strong>{formatCost(row.method.cost) && <small>{formatCost(row.method.cost)}</small>}</span></a>)}</div></section>}
        {additionalItems.length > 0 && <section class="item-shop-group"><h3>Additional Listings</h3><div class="item-shop-grid">{additionalItems.map(row => <a class="item-shop-card" data-item-version={row.version} href={`/item/${row.item.name}`}><img src={row.item.sprite} alt="" width="32" height="32" loading="lazy" /><span><strong>{row.item.displayName}</strong></span></a>)}</div></section>}
      </div>
    </details> : <section class="location-section"><h2>Items Found Here <small>{data.items.length}</small></h2><div class="item-links">{data.items.map(item => <a href={`/item/${item.name}`}>{item.displayName}</a>)}</div></section>)}
    {data.oaksNotes && <section class="location-section"><h2>{data.oaksNotes.title ?? 'Notes'}</h2>{(data.oaksNotes.body ?? []).map(text => <p>{typeof text === 'string' ? text : text.text}</p>)}{(data.oaksNotes.sections ?? []).map(section => <section class="location-note"><h3>{section.heading}</h3>{section.links?.length > 0 && <div class="location-note-cards">{notePokemon(section.links).map(({ pokemon }) => <a class="location-note-card" href={`/pokemon/${pokemon.name}`}><span class="location-note-dex">#{String(pokemon.nationalDexNumber ?? pokemon.id).padStart(4, '0')}</span><img src={pokemon.sprite} alt={pokemon.displayName} width="88" height="88" loading="lazy" /><strong>{pokemon.displayName}</strong><span class="location-note-types">{(pokemon.types ?? []).map(type => <TypeBadge type={type} height="1.15rem" />)}</span></a>)}</div>}{section.keyStats?.length > 0 && <ul>{section.keyStats.map(stat => <li><strong>{stat.name}:</strong> {stat.description}</li>)}</ul>}</section>)}</section>}
    <nav class="sr-only" aria-label="Breadcrumb"><a href="/">PokéLore</a> › <a href="/locations">Locations</a> › {data.displayName}</nav>
  </article>
</BaseLayout>
<style>
  .location-detail{box-sizing:border-box;margin:0 auto;max-width:1100px;padding:2rem 1rem 4rem}.location-back{border:1px solid #555;border-radius:999px;color:inherit;display:inline-block;margin-bottom:1.5rem;padding:.45rem .85rem}.location-detail header{text-align:center}.location-region{color:#fab856;font-size:.85rem;font-weight:800;letter-spacing:.06em;margin:0;text-transform:uppercase}.location-detail h1{font-size:clamp(2.2rem,6vw,4.5rem);line-height:1.05;margin:.4rem 0}.location-summary{color:#b8c7df;font-size:1.05rem;line-height:1.55;margin:0 auto 1rem;max-width:800px}.location-generations{text-align:center}.location-section,.location-area{border:2px solid #4d4d55;border-radius:14px;margin:1.25rem 0;padding:1rem}.location-section h2,.location-area h2{margin-top:0}.location-section h2 small{font-size:.8rem;font-weight:400}.location-section>summary{align-items:center;color:#63d5e8;cursor:pointer;display:flex;font-size:1.35rem;font-weight:700;justify-content:space-between;list-style:none}.location-section>summary::-webkit-details-marker{display:none}.location-section>summary::before{content:'▾';margin-right:.5rem}.location-section:not([open])>summary::before{content:'▸'}.location-section>summary small{color:#b8c7df;font-size:.9rem;font-weight:400}.encounter-content{margin-top:.65rem}.encounter-content label{display:block;font-weight:700;margin-bottom:.35rem}.encounter-content select,.item-version-filter select{background:#2c2c2c;border:2px solid #555;border-radius:10px;color:white;font-size:1rem;margin:.25rem 0 .65rem;padding:.4rem .6rem}.area-links,.item-links{display:flex;flex-wrap:wrap;gap:.5rem}.area-links a,.item-links a{background:#202026;border:1px solid #555;border-radius:8px;padding:.45rem .65rem}:global(.sprite-column){padding-left:.15rem;padding-right:.15rem;text-align:right;width:2.2rem}:global(.pokemon-name-column){text-align:left!important;width:38%}:global(.encounter-sprite){display:inline-block;height:24px;margin-right:.3rem;object-fit:contain;vertical-align:middle;width:24px}.encounter-area{border-top:1px solid #555;margin-top:.7rem;padding-top:.55rem}.encounter-area:first-child{border-top:0;margin-top:0;padding-top:0}.encounter-area h3{color:#63d5e8;font-size:1.1rem;margin:0 0 .35rem}.encounter-method{margin:.3rem 0 .55rem}.encounter-method h4{color:#b8c7df;font-size:1.05rem;margin:0;text-align:left}.encounter-table-wrap{overflow-x:auto}.encounter-table-wrap table{border-collapse:collapse;min-width:500px;table-layout:fixed;width:100%}th,td{border-bottom:1px solid #555;padding:.3rem .45rem;text-align:left !important}:global(.encounter-table-wrap th),:global(.encounter-table-wrap td){border-bottom:1px solid #555;padding:.3rem .45rem;text-align:left!important}th{color:#fab856}.notice,.method-list{color:#b8c7df;line-height:1.5}.item-shop-groups{display:grid;gap:1rem;margin-top:.75rem}.item-shop-group h3{color:#63d5e8;font-size:1.2rem;margin:.2rem 0 .5rem}.item-shop-subgroup{margin-top:.6rem}.item-shop-subgroup h4{color:#b8c7df;margin:.25rem 0;font-size:1rem}.item-shop-grid{display:grid;gap:.5rem;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}.item-shop-card{align-items:center;border:1px solid #555;border-radius:10px;color:inherit;display:flex;gap:.65rem;padding:.55rem;text-decoration:none}.item-shop-card img{height:32px;image-rendering:pixelated;width:32px}.item-shop-card strong,.item-shop-card small{display:block}.item-shop-card small{color:#b8c7df;margin-top:.15rem}.item-version-filter{display:block;font-weight:700;margin:.75rem 0}.item-version-filter select{display:block}@media(max-width:600px){.location-detail{padding:1.25rem .25rem 3rem}.location-section,.location-area{padding:.8rem}}
</style>
<style>
.location-note{border-top:1px solid #555;margin-top:1rem;padding-top:.75rem}.location-note h3{color:#63d5e8;margin:.1rem 0 .55rem}.location-note-cards{display:grid;gap:.6rem;grid-template-columns:repeat(auto-fill,minmax(120px,1fr))}.location-note-card{background:#292929;border:1px solid #555;border-radius:10px;color:inherit;display:flex;flex-direction:column;align-items:center;gap:.2rem;padding:.4rem;text-decoration:none}.location-note-card img{height:88px;object-fit:contain;width:88px}.location-note-card strong{font-size:.85rem;text-align:center}.location-note-dex{align-self:flex-start;color:#92929b;font-size:.72rem}.location-note-types{display:flex;flex-wrap:wrap;gap:.2rem;justify-content:center}
</style>
<script>
  const refreshEncounterTables = section => {
    section.querySelectorAll('.encounter-method').forEach(method => {
      const tbody = method.querySelector('tbody');
      if (!method._rawRows) method._rawRows = [...tbody.querySelectorAll('tr[data-game]')].map(row => row.cloneNode(true));
      tbody.replaceChildren(...method._rawRows.map(row => row.cloneNode(true)));
      const rows = [...tbody.querySelectorAll('tr[data-game]')];
      const selectedGame = section.querySelector('#location-game-filter')?.value ?? 'all';
      rows.forEach(row => { row.hidden = selectedGame !== 'all' && row.dataset.game !== selectedGame; });
      const groups = new Map();
      rows.forEach(row => {
        if (row.hidden) return;
        const key = row.dataset.pokemon;
        const group = groups.get(key) ?? { row, min: Infinity, max: -Infinity, chance: 0, hasChance: true };
        const min = Number(row.dataset.minLevel), max = Number(row.dataset.maxLevel);
        if (Number.isFinite(min)) group.min = Math.min(group.min, min);
        if (Number.isFinite(max)) group.max = Math.max(group.max, max);
        if (row.dataset.chance === '') group.hasChance = false; else group.chance += Number(row.dataset.chance);
        groups.set(key, group);
      });
      tbody.innerHTML = [...groups.values()].map(group => {
        const row = group.row;
        const level = group.min === Infinity ? '—' : group.min === group.max ? `Lv. ${group.min}` : `Lv. ${group.min}-${group.max}`;
        const chance = group.hasChance ? `${group.chance}%` : '—';
        return `<tr><td class="sprite-column"><img class="encounter-sprite" src="${row.dataset.sprite}" alt="" width="24" height="24" loading="lazy"></td><td class="pokemon-name-column"><a href="/pokemon/${row.dataset.pokemon}">${row.dataset.display}</a></td><td>${level}</td><td>${chance}</td></tr>`;
      }).join('');
      method.hidden = groups.size === 0;
    });
    section.querySelectorAll('.encounter-area').forEach(area => {
      area.hidden = ![...area.querySelectorAll('.encounter-method')].some(method => !method.hidden);
    });
  };
  document.querySelectorAll('.encounter-section').forEach(section => {
    const filter = section.querySelector('#location-game-filter');
    if (!filter) return;
    filter.addEventListener('change', () => {
      section.querySelectorAll('tbody tr[data-game]').forEach(row => {
        row.hidden = filter.value !== 'all' && row.dataset.game !== filter.value;
      });
      section.querySelectorAll('.encounter-method').forEach(method => {
        method.hidden = ![...method.querySelectorAll('tbody tr[data-game]')].some(row => !row.hidden);
      });
      section.querySelectorAll('.encounter-area').forEach(area => {
        area.hidden = ![...area.querySelectorAll('.encounter-method')].some(method => !method.hidden);
      });
      refreshEncounterTables(section);
    });
    refreshEncounterTables(section);
  });
  document.querySelectorAll('.pokeathlon-items').forEach(section => {
    const filter = section.querySelector('#location-item-version-filter');
    if (!filter) return;
    const refreshItems = () => {
      section.querySelectorAll('[data-item-version]').forEach(card => { card.hidden = card.dataset.itemVersion !== filter.value; });
      section.querySelectorAll('.item-shop-subgroup').forEach(group => { group.hidden = ![...group.querySelectorAll('.item-shop-card')].some(card => !card.hidden); });
      section.querySelectorAll('.item-shop-group').forEach(group => { group.hidden = ![...group.querySelectorAll('.item-shop-card')].some(card => !card.hidden); });
    };
    filter.addEventListener('change', refreshItems);
    refreshItems();
  });
</script>
