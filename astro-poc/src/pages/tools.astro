---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicHref } from '../lib/links.js';

const tools = [
  ['Pokémon Card Challenge', '/tcg-challenge', 'Open vintage virtual booster packs and build a seeded Pokémon videogame challenge team.'],
  ['Team Builder', '/team-coverage', 'Build a Pokémon party and check offensive type coverage for a selected game.'],
  ['Best EV Training Locations Calculator', '/ev-training-routes', 'Find the best repeatable wild encounter locations for training a chosen EV stat.'],
  ['DPPt Feebas Calculator', '/dppt-feebas-calculator', 'Calculate possible Feebas tiles in Diamond, Pearl, and Platinum.'],
  ['RSE Feebas Calculator', '/rse-feebas-calculator', 'Find Route 119 Feebas tiles in Ruby, Sapphire, and Emerald from a save file or game information.'],
  ['Single Type Coverage', '/single-type-coverage', 'Choose a game and defensive type to find Pokémon that can hit it super-effectively.']
];
const canonical = 'https://pokelore.net/tools';
---
<BaseLayout seo={{ title: 'Pokemon Tools and Calculators | PokéLore', description: 'Use Pokemon tools for team coverage, EV training routes, Feebas tiles, and single type coverage planning.', canonical }}>
  <article class="tools-page">
    <header><h1>Tools</h1><p>Calculators and planning helpers for Pokémon teams, encounters, and game-specific routing.</p></header>
    <section aria-label="Pokémon tools" class="tools-grid">
      {tools.map(([title, path, description]) => <a href={publicHref(path)}><h2>{title}</h2><p>{description}</p><span>Open tool</span></a>)}
    </section>
  </article>
</BaseLayout>
<style>
  .tools-page{box-sizing:border-box;display:grid;gap:1.5rem;margin:0 auto;max-width:1040px;padding:2rem;text-align:left;width:100%}
  .tools-page header{text-align:center}.tools-page h1{letter-spacing:0;margin-bottom:.75rem}.tools-page header p{margin:0 auto;max-width:720px}
  .tools-grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
  .tools-grid a{background:#202129;border:1px solid #3f4350;border-radius:8px;color:inherit;display:grid;gap:.75rem;min-height:150px;padding:1rem;text-decoration:none}
  .tools-grid h2{letter-spacing:0;margin:0}.tools-grid p{margin:0}.tools-grid span{color:var(--link-unvisited);font-weight:700;margin-top:auto}
  @media(max-width:600px){.tools-page{padding:1rem}}
</style>
