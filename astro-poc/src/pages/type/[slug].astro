---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import typeColors from '../../../../src/constants/typeColors.js';
import { TYPE_STRESS_SLUGS, typeModel } from '../../lib/typeData.js';
export function getStaticPaths() { return TYPE_STRESS_SLUGS.map(slug => ({ params: { slug }, props: { data: typeModel(slug) } })); }
const data = Astro.props.data ?? typeModel(Astro.params.slug);
const label = value => String(value ?? '').split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
const value = (number, suffix = '') => number == null ? '—' : `${number}${suffix}`;
const matchupGroups = (title, rows) => ({ title, rows });
---
<BaseLayout seo={data.seo}>
  <article class="type-detail" style={`--type-color:${typeColors[data.slug] ?? '#f5f5f5'}`}>
    <a class="type-back" href="/types">← All Types</a>
    <header><TypeBadge type={data.slug} height="2.6rem" /><h1>{data.name} Type</h1><p>{data.summary}</p></header>
    <section class="matchups"><h2>Offensive Matchups</h2><div class="matchup-columns">{[matchupGroups('2×', data.offense.strong), matchupGroups('0.5×', data.offense.resisted)].map(group => <section class="matchup-card"><h3>{group.title}</h3><div>{group.rows.length ? group.rows.map(row => <span class="matchup"><TypeBadge type={row.type} height="1.5rem" /><strong>{row.multiplier}×</strong></span>) : <p>None</p>}</div></section>)}</div><h2>Defensive Matchups</h2><div class="matchup-columns">{[matchupGroups('2×', data.defense.strong), matchupGroups('0.5×', data.defense.resisted)].map(group => <section class="matchup-card"><h3>{group.title}</h3><div>{group.rows.length ? group.rows.map(row => <span class="matchup"><TypeBadge type={row.type} height="1.5rem" /><strong>{row.multiplier}×</strong></span>) : <p>None</p>}</div></section>)}</div></section>
    <section class="type-section pokemon-list"><header class="list-heading"><h2>{data.name} Pokémon sorted by stats</h2><small>{data.pokemon.length} Pokémon</small></header><div class="controls"><label for="pokemon-sort">Sort by</label><select id="pokemon-sort"><option value="dex">Nat. Dex. Number</option><option value="bst">BST</option><option value="hp">HP</option><option value="attack">Attack</option><option value="defense">Defense</option><option value="specialAttack">Sp. Atk</option><option value="specialDefense">Sp. Def</option><option value="speed">Speed</option></select><select id="pokemon-direction"><option value="desc">Descending</option><option value="asc">Ascending</option></select></div><div id="pokemon-cards" class="pokemon-card-grid">{data.pokemon.map(p => <a class="pokemon-summary-card" data-slug={p.slug} data-dex={p.dexNumber} data-bst={p.bst} data-hp={p.stats.hp} data-attack={p.stats.attack} data-defense={p.stats.defense} data-special-attack={p.stats.specialAttack} data-special-defense={p.stats.specialDefense} data-speed={p.stats.speed} href={`/pokemon/${p.slug}`}><span class="dex-number">#{String(p.dexNumber).padStart(4,'0')}</span><img src={p.sprite} alt={p.displayName} width="100" height="100" loading="lazy" /><strong>{p.displayName}</strong><span class="card-types">{p.types.map(type => <TypeBadge type={type} height="1.2rem" />)}</span></a>)}</div></section>
    <details class="type-section"><summary><span>{data.name} Moves</span><small>{data.moves.length} moves</small></summary><div class="controls"><label for="move-sort">Sort by power</label><select id="move-sort"><option value="default">Default order</option><option value="desc">Power descending</option><option value="asc">Power ascending</option></select></div><div class="table-wrap"><table id="move-table"><thead><tr><th>Move</th><th>Category</th><th>Power</th><th>Accuracy</th><th>PP</th><th>Generation</th></tr></thead><tbody>{data.moves.map(move => <tr data-power={move.power ?? ''}><td><a href={`/move/${move.slug}`}>{move.name}</a></td><td>{label(move.category)}</td><td>{value(move.power)}</td><td>{value(move.accuracy, '%')}</td><td>{value(move.pp)}</td><td>{label(move.generation)}</td></tr>)}</tbody></table></div></details>
    <details class="type-section"><summary><span>{data.name} Abilities</span><small>{data.abilities.length} abilities</small></summary><div class="ability-grid">{data.abilities.map(ability => <a class="ability-card" href={`/ability/${ability.slug}`}><strong>{ability.name}</strong><span>{ability.shortEffect || 'Ability details available on its page.'}</span></a>)}</div></details>
  </article>
</BaseLayout>
<style>
  .type-detail{box-sizing:border-box;margin:0 auto;max-width:1150px;padding:2rem 1rem 4rem}.type-back{display:inline-block;margin-bottom:1rem}.type-detail header{text-align:center}.type-detail header>.type-badge{display:block;margin:0 auto}.type-detail header h1{color:var(--type-color);font-size:clamp(2rem,5vw,3.5rem);line-height:1.1;margin:1rem 0 .9rem}.type-detail header p{color:#b8c7df;line-height:1.5;margin:0 auto 1.5rem;max-width:760px}.type-section,.matchup-card{border:2px solid #4d4d55;border-radius:14px;margin:1rem 0;padding:1rem}.matchups>h2{text-align:center;margin:1.2rem 0 .55rem}.matchup-columns{display:grid;gap:1rem;grid-template-columns:repeat(2,minmax(0,1fr))}.matchup-card{margin:0;text-align:center}.matchup-card h3{color:#b8c7df;margin:0 0 .5rem}.matchup-card>div{align-items:center;display:flex;flex-wrap:wrap;gap:.65rem;justify-content:center}.matchup{align-items:center;display:inline-flex;gap:.25rem}.type-section h2{margin:0}.list-heading{align-items:center;display:flex;justify-content:space-between}.list-heading small{color:#b8c7df}.controls{align-items:center;display:flex;flex-wrap:wrap;gap:.5rem;margin:.8rem 0}.controls select{background:#2c2c2c;border:2px solid #555;border-radius:8px;color:#fff;padding:.4rem .55rem}.pokemon-card-grid{display:grid;gap:.7rem;grid-template-columns:repeat(auto-fill,minmax(135px,1fr))}.pokemon-summary-card{background:#292929;border:2px solid #555;border-radius:14px;color:inherit;display:flex;flex-direction:column;align-items:center;gap:.3rem;padding:.45rem;text-decoration:none;position:relative}.pokemon-summary-card img{height:100px;object-fit:contain;width:100px}.pokemon-summary-card strong{font-size:.9rem;text-align:center}.dex-number{align-self:flex-start;color:#92929b;font-size:.8rem}.card-types{display:flex;flex-wrap:wrap;gap:.25rem;justify-content:center}.ability-grid{display:grid;gap:.7rem;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));margin-top:.8rem}.ability-card{border:1px solid #555;border-radius:9px;color:inherit;display:grid;gap:.35rem;padding:.7rem;text-decoration:none}.ability-card span{color:#b8c7df;font-size:.9rem;line-height:1.35}@media(max-width:600px){.type-detail{padding:1.25rem .35rem 3rem}.type-section{padding:.75rem}.matchup-columns{grid-template-columns:1fr}}
</style>
<script>
  const cards = document.querySelector('#pokemon-cards'), sort = document.querySelector('#pokemon-sort'), direction = document.querySelector('#pokemon-direction');
  function sortPokemon() { const key = sort.value; const sign = direction.value === 'asc' ? 1 : -1; [...cards.querySelectorAll('.pokemon-summary-card')].sort((a,b) => (Number(a.dataset[key === 'specialAttack' ? 'specialAttack' : key]) - Number(b.dataset[key === 'specialDefense' ? 'specialDefense' : key])) * sign).forEach(row => cards.append(row)); }
  sort?.addEventListener('change', sortPokemon); direction?.addEventListener('change', sortPokemon);
  const moveSort = document.querySelector('#move-sort'), moveTable = document.querySelector('#move-table');
  moveSort?.addEventListener('change', () => { const mode = moveSort.value; if (mode === 'default') return; const sign = mode === 'asc' ? 1 : -1; [...moveTable.tBodies[0].rows].sort((a,b) => ((Number(a.dataset.power) || -1) - (Number(b.dataset.power) || -1)) * sign).forEach(row => moveTable.tBodies[0].append(row)); });
</script>
