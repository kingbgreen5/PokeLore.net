{
  "name": "pokedex-search",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:topics && npm run generate:sitemap",
    "build": "vite build",
    "generate:topics": "node scripts/generatePokedexTopics.js",
    "generate:locations": "node scripts/generateLocationsAndEncounters.js",
    "generate:sprite-bounds": "node scripts/generatePokemonSpriteBounds.js",
    "migrate:item-locations": "node scripts/migrateItemLocations.js",
    "generate:location-items": "node scripts/generateLocationItems.js",
    "generate:sitemap": "node scripts/generateSitemap.js",
    "enrich:moves-machines": "node scripts/enrichMovesWithMachineItems.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "nodemon": "^3.1.14",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
