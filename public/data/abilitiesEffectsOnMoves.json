{
  "schemaVersion": 1,
  "description": "Machine-readable defensive effects of abilities for Team Builder matchup calculations. Apply effects after the normal type-chart multiplier unless an effect uses set-damage-multiplier or block-move.",
  "effectTypes": {
    "set-damage-multiplier": "Replaces the calculated type-chart multiplier for matching incoming moves.",
    "multiply-damage": "Multiplies the calculated damage multiplier for matching incoming moves.",
    "block-move": "Prevents a matching move from affecting the defender.",
    "set-effectiveness": "Changes the type-effectiveness result in a context-dependent way.",
    "dynamic-type-change": "Changes defensive typing and requires live battle context.",
    "damage-prevention": "Prevents or reduces damage only while a stated battle condition is true.",
    "prevent-ohko": "Prevents a one-hit knockout without changing ordinary damage."
  },
