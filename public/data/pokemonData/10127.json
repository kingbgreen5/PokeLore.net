  "dexEntries": [
    {
      "versions": [
        "sun"
      ],
      "text": "When it’s in trouble, its eyes moisten and begin to shine. The shining light attracts its comrades, and they stand together against their enemies."
    },
    {
      "versions": [
        "moon"
      ],
      "text": "It’s awfully weak and notably tasty, so everyone is always out to get it. As it happens, anyone trying to bully it receives a painful lesson."
    },
    {
      "versions": [
        "ultra-sun"
      ],
      "text": "They’re weak, so they move in schools. However, they can also often be seen all alone, having strayed from the school."
    },
    {
      "versions": [
        "ultra-moon"
      ],
      "text": "When it’s in a jam, its shining eyes attract others of its kind. The light from its eyes is visible almost 25 miles away."
    },
    {
      "versions": [
        "sword"
      ],
      "text": "Individually, they’re incredibly weak. It’s by gathering up into schools that they’re able to confront opponents."
    },
    {
      "versions": [
        "shield"
      ],
      "text": "When it senses danger, its eyes tear up. The sparkle of its tears signals other Wishiwashi to gather."
